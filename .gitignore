data/processed/synthetic_employees_*.csv

# --- Local database (regenerate with: make seed) ---
data/db/*.db
data/db/*.sqlite3

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- NOTE: model artifacts under ml/artifacts/*.pkl are intentionally COMMITTED ---
